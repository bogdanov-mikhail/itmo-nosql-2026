# Образец: скопировать в .env и заполнить реальными значениями.
# .env в git не попадает (см. .gitignore). Пароли >= 12 символов, разные.
# Пароль встроенного администратора задаётся при первом старте узлов OpenSearch.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me-admin-min-12-chars
KIBANASERVER_PASSWORD=change-me-kibana-min-12-chars
LOGSHIPPER_PASSWORD=change-me-shipper-min-12-chars
ANALYST_PASSWORD=change-me-analyst-min-12-chars
METRICSAGENT_PASSWORD=change-me-metrics-min-12-chars
GRAFANA_ADMIN_PASSWORD=change-me-grafana-min-12-chars
