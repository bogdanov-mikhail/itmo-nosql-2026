{
  "policy": {
    "description": "Логи nginx: rollover 1МБ/1мин, перенос в warm, удаление через 10 минут",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [{"rollover": {"min_size": "1mb", "min_index_age": "1m"}}],
        "transitions": [{"state_name": "warm", "conditions": {"min_rollover_age": "1m"}}]
      },
      {
        "name": "warm",
        "actions": [{"allocation": {"require": {"temp": "warm"}}}, {"read_only": {}}],
        "transitions": [{"state_name": "delete", "conditions": {"min_index_age": "10m"}}]
      },
      {"name": "delete", "actions": [{"delete": {}}]}
    ],
    "ism_template": [{"index_patterns": ["logs"], "priority": 100}]
  }
}
